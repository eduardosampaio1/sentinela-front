# Modo de NAVEGACAO MANUAL (validacao de design). Nao e build de producao.
#
# Espelha exatamente o que o playwright.config.ts injeta no dev server, porque e essa combinacao
# que faz o MSW interceptar: o worker registra os handlers na origem do proprio dev server, entao
# a base do Gateway TEM de ser essa mesma origem. Apontando para outro lugar (o .env.local aponta
# para o homol no Railway), o mock fica inerte e a tela fala com o backend de verdade.
VITE_E2E=true
VITE_SENTINELA_MOCK=on
VITE_SENTINELA_API_URL=http://localhost:5175
VITE_SENTINELA_CANONICAL_ANALYSIS_ENABLED=true