# Dockerfile do front (SPA Vite) para o Railway.
# Multi-stage: build (Node) -> serve estático em $PORT com fallback de SPA.
#
# ⚠️ Gotcha Vite: as VITE_* são "assadas" no bundle DURANTE O BUILD (não em runtime).
# O Railway passa as service variables como build args; por isso declaramos ARG p/ cada
# VITE_* e as promovemos a ENV antes do `npm run build`. Setar as vars no serviço basta.

# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_AUTH_PROVIDER
ARG VITE_KEYCLOAK_ISSUER
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_SENTINELA_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_AUTH_PROVIDER=$VITE_AUTH_PROVIDER \
    VITE_KEYCLOAK_ISSUER=$VITE_KEYCLOAK_ISSUER \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID \
    VITE_SENTINELA_API_URL=$VITE_SENTINELA_API_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---------- serve ----------
FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY server.cjs ./server.cjs
EXPOSE 8080
# Servidor estático próprio (Node puro): serve arquivos com precedência correta
# (arquivo -> .html -> index de diretório) e faz fallback de SPA -> index.html
# p/ o React Router (/auth/callback etc.). Substitui `serve -s`, que reescrevia
# TODO .html aninhado p/ o index e quebrava os protótipos estáticos em /projects.
CMD ["node", "server.cjs"]
